# ─── AgriBridge Environment Variables ───────────────────────────────────────
# Weather and Maps use free, keyless libraries (wttr.in + geopy). No extra keys needed.

# JWT Security
JWT_SECRET=agribridge-super-secret-jwt-key-change-in-production

# ─── Groq AI (Primary: Chatbot, Farm Simulator, Live Prices, Farming Academy) ─
# Get your FREE key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ─── DeepSeek AI (Primary: Fertilizer Advisor) ───────────────────────────────
# Get your key from: https://platform.deepseek.com
# Falls back to Groq if key is missing
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ─── Google Gemini (Primary: Crop Doctor — vision analysis) ──────────────────
# Get your FREE key from: https://aistudio.google.com/apikey
# Falls back to Groq Vision if key is missing
GEMINI_API_KEY=your_gemini_api_key_here

# ─── OpenRouter (Primary: Yield Prediction) ──────────────────────────────────
# Get your key from: https://openrouter.ai/keys
# Falls back to Groq if key is missing
OPENROUTER_API_KEY=your_openrouter_api_key_here
